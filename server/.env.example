NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/REPLACE_DATABASE
JWT_SECRET=REPLACE_WITH_RANDOM_SERVER_ONLY_SECRET
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=REPLACE_WITH_PUBLIC_GOOGLE_CLIENT_ID
EMAILJS_SERVICE_ID=REPLACE_SERVICE_ID
EMAILJS_TEMPLATE_ID=REPLACE_TEMPLATE_ID
EMAILJS_RESET_TEMPLATE_ID=REPLACE_RESET_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=REPLACE_PUBLIC_KEY
# Optional server-only values. Recovery remains off unless separately approved.
EMAILJS_PRIVATE_KEY=
ENABLE_STARTUP_RECOVERY=false
QWEN_SERVICE_URL=http://127.0.0.1:8000
QWEN_MODEL=ggml-org/Qwen3-1.7B-GGUF:Q4_K_M
QWEN_DEBUG=false
# Render hybrid: HTTPS URL + Cloudflare Service Auth pair + origin token required.
QWEN_REQUIRE_SECURE_PROXY=false
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
QWEN_PROXY_API_KEY=
